#!/usr/bin/env python3
"""Hide or show Newelle windows through the user KWin scripting API."""

import os
import subprocess
import sys
import tempfile

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib


def session_environment():
    env = os.environ.copy()
    required = ("DISPLAY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS")
    if any(not env.get(name) for name in required):
        try:
            output = subprocess.check_output(
                ["systemctl", "--user", "show-environment"], text=True, timeout=2
            )
            for line in output.splitlines():
                name, separator, value = line.partition("=")
                if separator and name in required and value:
                    env[name] = value
        except Exception:
            pass
    return env


def run_action(action):
    print(f"KWin Newelle helper: action={action}", flush=True)
    service = f"org.maya.NewelleWindow{os.getpid()}"
    path = "/org/maya/NewelleWindow"
    interface = "org.maya.NewelleWindow"
    xml = """<node><interface name="org.maya.NewelleWindow">
      <method name="Matched"/><method name="Visible"/>
    </interface></node>"""
    node = Gio.DBusNodeInfo.new_for_xml(xml)
    state = set()

    def method_call(_connection, _sender, _object_path, _interface, method, _params, invocation):
        state.add(method)
        print(f"KWin Newelle helper: matched Newelle; callback={method}", flush=True)
        invocation.return_value(None)

    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    bus.register_object(path, node.interfaces[0], method_call, None, None)
    bus.call_sync(
        "org.freedesktop.DBus", "/org/freedesktop/DBus",
        "org.freedesktop.DBus", "RequestName",
        GLib.Variant("(su)", (service, 0)), GLib.VariantType("(u)"),
        Gio.DBusCallFlags.NONE, 2000, None,
    )

    script = f"""
var action = '{action}';
workspace.windowList().forEach(function(window) {{
    var desktop = String(window.desktopFileName || '').toLowerCase();
    var resource = String(window.resourceClass || '').toLowerCase();
    var caption = String(window.caption || '').toLowerCase();
    var match = desktop === 'io.github.qwersyk.newelle' ||
        desktop === 'newelle' || resource === 'io.github.qwersyk.newelle' ||
        resource === 'newelle' || caption.indexOf('newelle') >= 0;
    if (!match) return;
    if (action === 'hide') {{
        window.skipTaskbar = true;
        window.skipSwitcher = true;
        window.minimized = true;
    }} else {{
        window.skipTaskbar = false;
        window.skipSwitcher = false;
        window.minimized = false;
        workspace.raiseWindow(window);
        workspace.activeWindow = window;
    }}
    callDBus('{service}', '{path}', '{interface}', 'Matched', function() {{}});
    if (!window.minimized && !window.hidden && !window.deleted)
        callDBus('{service}', '{path}', '{interface}', 'Visible', function() {{}});
}});
"""
    fd, script_path = tempfile.mkstemp(prefix="maya-newelle-", suffix=".js", dir="/tmp")
    os.close(fd)
    with open(script_path, "w", encoding="utf-8") as stream:
        stream.write(script)
    env = session_environment()
    script_id = f"maya-newelle-{os.getpid()}"
    try:
        loaded = subprocess.run(
            ["qdbus6", "org.kde.KWin", "/Scripting",
             "org.kde.kwin.Scripting.loadScript", script_path, script_id],
            env=env, capture_output=True, text=True, timeout=3,
        )
        if loaded.returncode != 0:
            print(f"KWin Newelle helper: loadScript failed: {loaded.stderr.strip()}", flush=True)
            return False
        started = subprocess.run(
            ["qdbus6", "org.kde.KWin", "/Scripting",
             "org.kde.kwin.Scripting.start"],
            env=env, capture_output=True, text=True, timeout=3,
        )
        if started.returncode != 0:
            print(f"KWin Newelle helper: start failed: {started.stderr.strip()}", flush=True)
            return False
        loop = GLib.MainLoop()
        GLib.timeout_add(1200, loop.quit)
        loop.run()
        matched = "Matched" in state
        if not matched:
            print("KWin Newelle helper: no Newelle window matched", flush=True)
        return matched
    finally:
        subprocess.run(
            ["qdbus6", "org.kde.KWin", "/Scripting",
             "org.kde.kwin.Scripting.unloadScript", script_id],
            env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        try:
            os.unlink(script_path)
        except FileNotFoundError:
            pass


if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) == 2 else ""
    if action not in {"hide", "show"}:
        raise SystemExit("Usage: kwin-newelle-window {hide|show}")
    raise SystemExit(0 if run_action(action) else 1)

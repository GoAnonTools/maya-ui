#!/usr/bin/env python3
"""Ask KWin to place Maya after its Wayland surface has been created."""

import os
import subprocess
import sys
import tempfile

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib


def session_environment():
    env = os.environ.copy()
    required = ("DISPLAY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS")
    if any(not env.get(name) for name in required):
        try:
            output = subprocess.check_output(
                ["systemctl", "--user", "show-environment"], text=True, timeout=2
            )
            for line in output.splitlines():
                name, separator, value = line.partition("=")
                if separator and name in required and value:
                    env[name] = value
        except Exception:
            pass
    return env


def main():
    if len(sys.argv) != 5:
        raise SystemExit("Usage: kwin-place-maya x y width height")
    x, y, width, height = (int(value) for value in sys.argv[1:])
    print(
        f"KWin Maya placement: requested=({x}, {y}) size={width}x{height}",
        flush=True,
    )

    service = f"org.maya.PlaceWindow{os.getpid()}"
    path = "/org/maya/PlaceWindow"
    interface = "org.maya.PlaceWindow"
    xml = """<node><interface name="org.maya.PlaceWindow">
      <method name="Moved"/><method name="NotFound"/>
    </interface></node>"""
    node = Gio.DBusNodeInfo.new_for_xml(xml)
    state = set()

    def method_call(_connection, _sender, _object_path, _interface, method, params, invocation):
        state.add(method)
        print(f"KWin Maya placement: callback={method} details={params}", flush=True)
        invocation.return_value(None)

    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        bus.register_object(path, node.interfaces[0], method_call, None, None)
        bus.call_sync(
            "org.freedesktop.DBus", "/org/freedesktop/DBus",
            "org.freedesktop.DBus", "RequestName",
            GLib.Variant("(su)", (service, 0)), GLib.VariantType("(u)"),
            Gio.DBusCallFlags.NONE, 2000, None,
        )
    except Exception as error:
        print(f"KWin Maya placement: session bus unavailable: {error}", flush=True)
        return 1

    script = f"""
var moved = false;
workspace.windowList().forEach(function(window) {{
    var caption = String(window.caption || '').toLowerCase();
    if (caption !== 'maya') return;
    var right = {x} + {width} + 30;
    var bottom = {y} + {height} + 30;
    function anchorWindow() {{
        var targetX = right - window.width - 30;
        var targetY = bottom - window.height - 30;
        if (Math.abs(window.x - targetX) > 1 || Math.abs(window.y - targetY) > 1) {{
            window.frameGeometry = {{x: targetX, y: targetY, width: window.width, height: window.height}};
        }}
        print('Maya matched by KWin; frameGeometry=' + window.x + ',' + window.y + ',' + window.width + ',' + window.height);
    }}
    window.frameGeometryChanged.connect(anchorWindow);
    anchorWindow();
    callDBus('{service}', '{path}', '{interface}', 'Moved', function() {{}});
    moved = true;
}});
if (!moved) callDBus('{service}', '{path}', '{interface}', 'NotFound', function() {{}});
"""
    fd, script_path = tempfile.mkstemp(prefix="maya-kwin-place-", suffix=".js", dir="/tmp")
    os.close(fd)
    with open(script_path, "w", encoding="utf-8") as stream:
        stream.write(script)
    env = session_environment()
    script_id = f"maya-place-{os.getpid()}"
    try:
        loaded = subprocess.run(
            ["qdbus6", "org.kde.KWin", "/Scripting",
             "org.kde.kwin.Scripting.loadScript", script_path, script_id],
            env=env, capture_output=True, text=True, timeout=3,
        )
        if loaded.returncode != 0:
            print(f"KWin Maya placement: loadScript failed: {loaded.stderr.strip()}", flush=True)
            return 1
        started = subprocess.run(
            ["qdbus6", "org.kde.KWin", "/Scripting",
             "org.kde.kwin.Scripting.start"],
            env=env, capture_output=True, text=True, timeout=3,
        )
        if started.returncode != 0:
            print(f"KWin Maya placement: start failed: {started.stderr.strip()}", flush=True)
            return 1
        loop = GLib.MainLoop()
        GLib.timeout_add(1200, loop.quit)
        loop.run()
        return 0 if "Moved" in state else 1
    finally:
        subprocess.run(
            ["qdbus6", "org.kde.KWin", "/Scripting",
             "org.kde.kwin.Scripting.unloadScript", script_id],
            env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        try:
            os.unlink(script_path)
        except FileNotFoundError:
            pass


if __name__ == "__main__":
    raise SystemExit(main())
